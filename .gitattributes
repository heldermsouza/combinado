# Normaliza fim de linha para LF no repositório; checkout em LF em todas as plataformas.
* text=auto eol=lf

# Windows-only scripts precisam de CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=lf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.pfx binary

# Lockfiles: não mostrar diff por padrão
pnpm-lock.yaml -diff
packages.lock.json -diff
