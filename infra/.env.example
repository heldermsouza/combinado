# Copie para infra/.env. Valores abaixo são só para dev local — nunca use em staging/prod.
# Portas de host deslocadas (5435/6380) para não colidir com outros projetos que usam 5432/6379.
# Dentro da rede docker os serviços continuam nas portas padrão.

POSTGRES_USER=combinado
POSTGRES_PASSWORD=combinado
POSTGRES_DB=combinado
POSTGRES_PORT=5435

REDIS_PORT=6380

RABBITMQ_USER=combinado
RABBITMQ_PASSWORD=combinado
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

SEQ_PORT=5341

# Perfil "app" (api + workers + web)
API_PORT=8080
WEB_PORT=3000
