<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Entry point HTTP: minimal APIs versionadas em /api/v1, webhooks, health checks. -->

  <PropertyGroup>
    <RootNamespace>Combinado.Api</RootNamespace>
    <UserSecretsId>combinado-api</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup Label="Logging">
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup Label="Tooling">
    <!-- dotnet ef exige o pacote Design no startup project; não vai para o output de publish. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Combinado.Infrastructure\Combinado.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Combinado.Integration.Tests" />
  </ItemGroup>

</Project>
